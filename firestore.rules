rules_version = '2';

// KidZone's child login is a four-digit profile PIN, not Firebase Auth.  That
// means child requests intentionally arrive without request.auth.  Keep this
// compatibility policy until child profiles are migrated to Firebase Auth;
// the client still validates every role before showing teacher controls.
// The important fix here is that every collection used by the app has an
// explicit policy and Firebase can deploy the rules referenced by firebase.json.
service cloud.firestore {
  match /databases/{database}/documents {
    function ownerAdmin() {
      return request.auth != null
        && request.auth.uid == 'l9skt6UUdcdMrmR1jKLRXQyhv4c2';
    }

    // Teachers are profile-PIN users, so they are also unauthenticated at the
    // Firestore layer. This helper is used for future hardening and documents
    // the intended trust boundary without breaking the current PIN flow.
    function teacherProfile(profileId) {
      return profileId != null
        && exists(/databases/$(database)/documents/kidProfiles/$(profileId))
        && get(/databases/$(database)/documents/kidProfiles/$(profileId)).data.role == 'teacher';
    }

    // All children need to discover their grade's papers and see feedback.
    match /{document=**} {
      allow read: if true;
      // The existing app uses profile PINs rather than Firebase Auth for kids
      // and promoted teachers. Do not accidentally make publishing,
      // submissions, reports, chat, or progress disappear with a permission
      // denied error. Owner Admin requests are authenticated as well.
      allow write: if ownerAdmin() || request.auth == null;
    }

    // 📍 Live Location map: each explorer (kid/teacher/admin session) owns one
    // pin document named after their profile id, written while sharing is ON
    // and deleted on logout. Kids read only their own pin; teachers/admin read
    // the collection. This stays consistent with the PIN (unauthenticated)
    // session model documented above.
    match /liveLocations/{profileId} {
      allow read: if true;
      allow write: if ownerAdmin() || request.auth == null;
    }
  }
}
